{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craftcut/schemas/derive.schema.json",
  "title": "DeriveResult",
  "type": "object",
  "required": ["schema", "kind", "outputs", "wall_time_seconds"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "craftcut.derive.v1" },
    "kind": { "type": "string", "enum": ["landscape", "shorts"] },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "wall_time_seconds": { "type": "number" }
  }
}
