{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craftcut/schemas/section-map.schema.json",
  "title": "SectionMap",
  "description": "Operator-authored narrative blueprint. YAML in the project, validated against this JSON schema.",
  "type": "object",
  "required": ["schema_version", "project", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "target_duration", "segments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "snake_case identifier"
          },
          "target_duration": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "pattern": "^(PT[0-9]+[HMS](?:[0-9]+[MS])?(?:[0-9]+S)?|[0-9]+s|[0-9]+m|[0-9]+h|[0-9]+:[0-9]{2}(?::[0-9]{2})?)$" }
            ]
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["clip", "from", "to"],
              "additionalProperties": false,
              "properties": {
                "clip": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "description": "SourceClip.stem"
                },
                "from": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "string" }
                  ]
                },
                "to": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "string" }
                  ]
                },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
