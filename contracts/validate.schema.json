{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craftcut/schemas/validate.schema.json",
  "title": "ValidateReport",
  "type": "object",
  "required": ["schema", "status", "probed", "disk_budget", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "craftcut.validate.v1" },
    "status": { "type": "string", "enum": ["ok", "failed"] },
    "probed": {
      "type": "array",
      "items": { "$ref": "#/definitions/ProbeResult" }
    },
    "disk_budget": {
      "type": "object",
      "required": ["free_bytes", "required_bytes", "ok"],
      "properties": {
        "free_bytes": { "type": "integer" },
        "required_bytes": { "type": "integer" },
        "ok": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "detail"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "clip": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "ProbeResult": {
      "type": "object",
      "required": ["stem", "width", "height", "frame_rate", "duration_seconds", "video_codec", "size_bytes"],
      "properties": {
        "stem": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "rotation": { "type": ["integer", "null"] },
        "sample_aspect_ratio": { "type": "string" },
        "display_aspect_ratio": { "type": "string" },
        "frame_rate": { "type": "string", "description": "Fraction string, e.g. '60/1'" },
        "duration_seconds": { "type": "number" },
        "video_codec": { "type": "string" },
        "audio_streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codec", "sample_rate", "channels"],
            "properties": {
              "codec": { "type": "string" },
              "sample_rate": { "type": "integer" },
              "channels": { "type": "integer" }
            }
          }
        },
        "size_bytes": { "type": "integer" }
      }
    }
  }
}
